{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["org", "note", "intents"],
  "properties": {
    "org": { "type": "string" },
    "note": { "type": "string", "minLength": 20 },
    "intents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chainId", "intent"],
        "properties": {
          "chainId": { "type": "string", "minLength": 1 },
          "intent": { "type": "string", "minLength": 80 }
        }
      }
    }
  }
}
