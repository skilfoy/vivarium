{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["org", "tracker", "note", "tickets"],
  "properties": {
    "org": { "type": "string" },
    "tracker": { "type": "string" },
    "note": { "type": "string", "minLength": 20 },
    "tickets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "queue", "owner", "kind", "title", "status"],
        "properties": {
          "id": { "type": "string" },
          "queue": { "type": "string" },
          "owner": { "type": "string" },
          "kind": { "type": "string", "enum": ["work", "scope-expansion"] },
          "title": { "type": "string", "minLength": 4 },
          "status": { "type": "string", "enum": ["open", "pending"] },
          "targetOrg": { "type": "string" },
          "approver": { "type": "string" },
          "effect": { "type": "string" }
        }
      }
    }
  }
}
