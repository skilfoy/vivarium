{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "prefix", "operator", "fakeInternet", "orgs", "outOfScope", "alwaysDeny"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "prefix": { "type": "string", "pattern": "^[0-9.]+/[0-9]+$" },
    "operator": { "type": "string" },
    "fakeInternet": { "type": "string" },
    "orgs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "sector", "cidr", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "sector": { "type": "string", "minLength": 1 },
          "cidr": { "type": "string" },
          "status": { "type": "string", "enum": ["smoke", "denied"] }
        }
      }
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "role", "cidr", "reason"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "cidr": { "type": "string" },
          "reason": { "type": "string", "minLength": 8 }
        }
      }
    },
    "alwaysDeny": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cidr", "reason"],
        "properties": {
          "cidr": { "type": "string" },
          "reason": { "type": "string", "minLength": 4 }
        }
      }
    }
  }
}
