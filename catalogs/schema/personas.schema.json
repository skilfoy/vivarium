{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["org", "personas"],
  "properties": {
    "org": { "type": "string" },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "org", "role", "team", "habit"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "org": { "type": "string" },
          "role": { "type": "string" },
          "team": { "type": "string" },
          "habit": { "type": "string" },
          "engagementEnd": { "type": "string" }
        }
      }
    }
  }
}
