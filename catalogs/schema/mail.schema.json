{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["org", "domain", "store", "rule", "routes"],
  "properties": {
    "org": { "type": "string" },
    "domain": { "type": "string" },
    "store": { "type": "string" },
    "rule": { "type": "string", "minLength": 20 },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "subject"],
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "subject": { "type": "string", "minLength": 4 }
        }
      }
    }
  }
}
